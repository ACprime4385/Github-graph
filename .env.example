# CognoDB connection details (get these from https://console.cognodb.com)
NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=your_generated_password

# GitHub personal access token (https://github.com/settings/tokens) - optional, raises API rate limits
GITHUB_TOKEN=

FLASK_ENV=development
PORT=5000
